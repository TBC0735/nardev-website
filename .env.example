# Copie ce fichier en .env et remplis les valeurs. Ne commit JAMAIS .env.

# --- Base de données (Neon / Supabase) ---
# URL avec pooling pour l'app
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# URL directe (sans pooling) pour les migrations Prisma — optionnel selon l'hébergeur
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- NextAuth ---
# Générer : openssl rand -base64 32
NEXTAUTH_SECRET="remplace-moi"
NEXTAUTH_URL="http://localhost:3000"

# --- Seed admin (optionnel, sinon valeurs par défaut) ---
SEED_ADMIN_EMAIL="admin@nardev.sn"
SEED_ADMIN_PASSWORD="changeme123"

# --- Envoi d'email formulaire contact (domaine Awa) ---
# Optionnel : sans ces valeurs, les messages sont juste enregistrés en base
# (consultables dans /admin/messages), aucun email n'est envoyé.
# Clé API : https://resend.com (gratuit) → API Keys
# RESEND_API_KEY=""
# Adresse qui reçoit les demandes
# CONTACT_TO_EMAIL="equipe@nardev.sn"
# Expéditeur (doit être un domaine vérifié sur Resend ; défaut = onboarding@resend.dev)
# CONTACT_FROM_EMAIL="Nardev <contact@nardev.sn>"
